# KORZAL Protocol — Variables de entorno

# RPC endpoint (Alchemy, QuickNode, Helius recomendados para producción)
RPC_URL=https://api.mainnet-beta.solana.com

# IPFS via Pinata (obtener en pinata.cloud)
PINATA_JWT=your_pinata_jwt_here

# URIs de metadata (se generan con upload-metadata.js)
KRZL_METADATA_URI=ipfs://...
BALAM_METADATA_URI=ipfs://...

# Wallets de distribución (Solana public keys)
WALLET_TREASURY=your_treasury_wallet_public_key
WALLET_COMMUNITY=your_community_wallet_public_key
WALLET_TEAM=your_team_wallet_public_key
WALLET_ADVISORS=your_advisors_wallet_public_key
WALLET_RESERVE=your_reserve_wallet_public_key
