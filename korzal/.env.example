# KORZAL Protocol — Variables de entorno

# RPC endpoint (Helius, QuickNode o Alchemy recomendados para producción)
RPC_URL=https://api.mainnet-beta.solana.com

# IPFS via Pinata (obtener en pinata.cloud)
PINATA_JWT=your_pinata_jwt_here

# URIs de metadata (se generan con upload-metadata.js)
KRL_METADATA_URI=ipfs://...
BALAM_METADATA_URI=ipfs://...

# Wallets de distribución $KRL (Solana public keys)
WALLET_IDO=your_ido_wallet_public_key
WALLET_LIQUIDITY=your_liquidity_wallet_public_key
WALLET_TEAM=your_team_wallet_public_key
WALLET_ECOSYSTEM=your_ecosystem_wallet_public_key
WALLET_RESERVE=your_reserve_multisig_5of9_public_key
WALLET_STAKING=your_staking_contract_public_key
WALLET_MARKETING=your_marketing_wallet_public_key
